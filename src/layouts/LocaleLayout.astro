---
import BaseLayout from "./BaseLayout.astro";
import MainPage from "../components/MainPage";
import { translations } from "../i18n/translations";
import type { Locale } from "../i18n/translations";
import { poi } from "../config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = translations[lang];
const title = t.meta?.title || `${t.hero.title} | Sacsayhuaman Ruins`;
const description = t.meta?.description || t.about.p1.slice(0, 160);
---

<BaseLayout lang={lang} title={title} description={description} restPath="" mapsUrl={poi.mapsUrl} faqItems={t.faq.items}>
  <MainPage client:load locale={lang} />
</BaseLayout>
